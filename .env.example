# Copy this file to .env and fill in real values.
# .env is loaded automatically on startup (see Program.cs) and maps onto
# ASP.NET Core configuration using the standard "__" section separator.

# Password for certs/devcert.pfx (Kestrel HTTPS dev certificate)
Kestrel__Certificates__Default__Password=changeme

# Application name passed to the YouTube Data API
Google__ApplicationName=GoogleIntegrationService

# Google OAuth 2.0 credentials for "Sign in with Google" (see
# Web/Extensions/GoogleAuthExtensions.cs). Created in Google Cloud Console
# under APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI must match the google-callback route, e.g.
# https://localhost:7267/api/auth/google-callback
Authentication__Google__ClientId=changeme.apps.googleusercontent.com
Authentication__Google__ClientSecret=changeme_google_client_secret

# JWT authentication settings (see Web/Extensions/AuthenticationExtensions.cs
# and Services/TokenService.cs). SecretKey must be at least 32 characters
# long (HMAC-SHA256 requires a 256-bit key). Generate one with:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
JwtSettings__SecretKey=changeme_replace_with_32_char_secret
JwtSettings__Issuer=GoogleIntegrationService
JwtSettings__Audience=GoogleIntegrationServiceClient

# SQLite connection string (EF Core) — see Infrastructure/Data/AppDbContext.cs
ConnectionStrings__AppDb=Data Source=app.db
