{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "DefaultReturnUrl": "http://localhost:4200/",
    "AllowedReturnHosts": [ "localhost", "127.0.0.1" ]
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "certs/devcert.pfx"
      }
    }
  }
}
